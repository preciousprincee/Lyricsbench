# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Local dev: leave DATABASE_URL unset, uses a local SQLite file automatically.
# Render/production: DATABASE_URL is set for you if you deploy via render.yaml
# (points at the lyricbench-db Postgres instance).
DATABASE_URL=

# --- Groq (AI, server-side only, never sent to frontend) ---
GROQ_API_KEY=gsk_...
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# --- AI usage limit (no paywall — a flat monthly allowance for everyone) ---
MONTHLY_AI_GENERATIONS_LIMIT=500

# --- Scaling: Redis (shared cache, rate-limit counters, AI quota counters) ---
# Optional for local/demo use (falls back to in-memory). Required once you
# run more than one gunicorn worker/process — see README.md.
REDIS_URL=redis://localhost:6379/0
