# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (Supabase Postgres connection string, from Project Settings > Database) ---
# Use the "Connection pooling" URI (port 6543) in production, direct (5432) locally is fine too.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Supabase Auth ---
# Project Settings > API > Project URL
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Project Settings > API > Project API keys > anon/public (used only for reference, not required server-side)
SUPABASE_ANON_KEY=
# Project Settings > API > JWT Settings > JWT Secret (HS256 legacy secret)
# If your project uses the newer JWKS-based signing keys instead, leave this blank
# and JWKS verification (SUPABASE_URL/.well-known) will be used automatically.
SUPABASE_JWT_SECRET=

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_PLAN_CODE_PRO_MONTHLY=PLN_...
PAYSTACK_PLAN_CODE_PRO_YEARLY=PLN_...
FRONTEND_URL=http://localhost:5173

# --- Groq (AI, server-side only, never sent to frontend) ---
GROQ_API_KEY=gsk_...
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# --- Plan limits ---
FREE_PLAN_MONTHLY_GENERATIONS=40

# --- Scaling: Redis (shared cache, rate-limit counters, AI quota counters) ---
# Required once you run more than one gunicorn worker/process — see
# "Scaling to thousands of concurrent users" in README.md.
REDIS_URL=redis://localhost:6379/0
